{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gittor",
  "version": "0.1.0",
  "identifier": "dev.gittor.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [{ "title": "Gittor", "width": 1400, "height": 900, "minWidth": 600, "minHeight": 400, "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
